{
  "name": "@visualli/react",
  "version": "0.1.0",
  "description": "React canvas renderer for .visualli files — built on @visualli/core",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@visualli/core": "*",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "^4.5.2",
    "konva": "^9.3.6",
    "react-konva": "^18.2.10"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
